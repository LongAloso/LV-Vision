{
  "ConfigCenter": {
    "BaseUrl": "http://identityservice:5000",
    "TimeoutSeconds": 10,
    "FailoverSnapshotPath": "/data/config/config.snapshot.json"
  },
  "GatewayCors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:3001"],
    "AllowCredentials": true
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "TrustAll": false,
    "KnownNetworks": ["172.16.0.0/12"]
  },
  "AllowedHosts": "*"
}
