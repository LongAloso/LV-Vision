# =============================================
# LV-Vision — File mẫu biến môi trường (.env.example)
# Nói đơn giản: đây là tờ giấy ghi mật khẩu + địa chỉ.
# Bạn copy file này thành tên ".env" rồi điền mật khẩu thật.
# Code sẽ đọc từ .env, không ghi mật khẩu cứng trong code.
# Lệnh copy trên Git Bash: cp .env.example .env
# =============================================

# --- 1. JWT (thẻ ra vào) ---
# JWT__KEY: chìa khóa để ký thẻ JWT. PHẢI dài tối thiểu 32 ký tự.
# Tất cả service (C# Identity + Python) dùng CHUNG 1 key này thì mới đọc được thẻ của nhau.
LV_JWT_KEY=development-only-jwt-signing-key-toi-thieu-32-ky-tu-1234567890
LV_JWT_ISSUER=IdentityServiceDev
LV_JWT_AUDIENCE=IdentityClientsDev

# --- 2. SQL Server (cho IdentityService C# có sẵn) ---
# IdentityService hiện tại dùng SQL Server. Phase 0 chỉ vá startup Development
# để tạo database trống và cập nhật schema dev; không đổi luồng xác thực.
SQL_PASSWORD=ChangeMe_DevOnly_123!

# --- 3. PostgreSQL (sổ chính cho các service Python mới) ---
# Camera-service Phase 2A dùng schema camera trong database lvvision.
POSTGRES_USER=lvuser
POSTGRES_PASSWORD=ChangeMe_Pg_123!
POSTGRES_DB=lvvision
# Chuỗi kết nối mẫu cho Python (SQLAlchemy đọc từ env này):
# postgresql://lvuser:ChangeMe_Pg_123!@postgres:5432/lvvision

# --- 4. MongoDB (kho ảnh/log/clip) ---
MONGO_ROOT_USERNAME=lvadmin
MONGO_ROOT_PASSWORD=ChangeMe_Mongo_123!

# --- 5. Redis (băng chuyền việc) ---
# Redis không cần mật khẩu ở dev. Các hàng đợi:
# analytics:events, vision:clip:jobs, behavior:dryrun:jobs, plc:commands
REDIS_URL=redis://redis:6379/0

# --- 6. RabbitMQ (loa phát thanh, kế thừa Q-OneSPC) ---
RABBITMQ_USER=admin
RABBITMQ_PASS=development-only-rabbit-password

# --- 7. Key nội bộ (service gọi nhau, không cho web gọi) ---
SPC_INTERNAL_API_KEY=development-only-internal-api-key
CAMERA_RTSP_KEY=development-only-camera-rtsp-encryption-key-1234567890
SPC_CONFIGCENTER_INTERNAL_KEY=development-only-config-center-key
SPC_JWT_KEY=${LV_JWT_KEY}
